# Local development uses files. On Vercel, use blob and connect a PRIVATE store.
STORAGE_DRIVER=file
# BLOB_READ_WRITE_TOKEN=

# Required in production: generate with `openssl rand -hex 32` or equivalent.
# SESSION_SECRET=

# Create a Gemini API key at https://aistudio.google.com/apikey.
# Server-only. Use an eligible project WITHOUT billing for free-tier-only usage.
# Never use a NEXT_PUBLIC_ prefix or commit the actual key.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY is also supported; GEMINI_API_KEY takes precedence.
GEMINI_MODEL=gemini-2.5-flash-lite
