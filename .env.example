# Local development uses files. On Vercel, use blob and connect a PRIVATE store.
STORAGE_DRIVER=file
# BLOB_READ_WRITE_TOKEN=
# Connected Vercel stores use BLOB_STORE_ID + automatically managed OIDC instead.
# Do not manually copy or set VERCEL_OIDC_TOKEN in deployment settings.

# Required in production, on Vercel, and whenever ENTRA_* or Blob credentials are set:
# generate with `openssl rand -hex 32` or equivalent. Local development without it uses a
# random key per process.
# SESSION_SECRET=

# Microsoft Entra ID sign-in (single tenant). Production requires all three.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Local development only: with the ENTRA_* variables empty, DEV_LOGIN=1 signs you in as a
# fixed "Local Developer" test user. Ignored in production and on Vercel.
DEV_LOGIN=1

# Coach: a Copilot Studio agent in the company tenant. Direct Line secret from Agent settings →
# Safety & access → Web channel security. Without it the chat is disabled.
# COPILOT_DIRECT_LINE_SECRET=
# Copilot Studio answers from the region of its environment (global, europe or india endpoint);
# the server finds the right one by itself. Pin it only if needed:
# COPILOT_DIRECT_LINE_URL=https://europe.directline.botframework.com
